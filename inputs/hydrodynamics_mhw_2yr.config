# ==============================================================================
# hydrodynamics_mhw_2yr.config - Marine Heat Wave Scenario (2 Continuous Years)
# Architecture: NumericalEarth.jl + Oceananigans.jl Backend
# Domain: Scotian Shelf, Laurentian Channel & Continental Rise (~1 km resolved)
# ==============================================================================

[metadata]
name = "Scotian Shelf 2-Year Marine Heat Wave (MHW) Simulation"
description = "High-resolution thermal anomaly simulation with Warm Slope Water intrusion"
author = "Jae Choi"
version = "1.0.0"

[domain]
lon_min = -68.0                     # Western longitude boundary (°E)
lon_max = -57.0                     # Eastern longitude boundary (°E)
lat_min = 42.0                      # Southern latitude boundary (°N)
lat_max = 47.5                      # Northern latitude boundary (°N)
z_min = -5000.0                     # Abyssal plain maximum depth (meters)
z_max = 0.0                         # Sea surface datum (meters)
buffer_km = 50.0                    # Coastal buffer envelope (km)

[grid]
nx = 864                            # Zonal grid cell count (~1.0 km horizontal resolution)
ny = 611                            # Meridional grid cell count (~1.0 km horizontal resolution)
nz = 20                             # Number of stretched vertical layers
vertical_stretching_mode = "tanh"   # Hyperbolic tangent vertical layer stretching
vertical_grid_file = "inputs/scotian_shelf_vertical_grid.csv"
resolution_scale = 1.0              # Resolution scale factor (1.0 = full 864x611, 0.25 = 216x152 debug)

[bathymetry]
source = "gebco"                    # High-resolution GEBCO bathymetry (~450 m raw)
fallback_dataset_id = "etopo180"    # Fallback dataset ID if GEBCO tile absent
inshore_depth = -20.0               # Coastal boundary depth (meters)
shelf_slope = 500.0                 # Bathymetric continental slope scale (meters)

[atmosphere]
source = "mhw"                      # Atmospheric forcing with marine heatwave thermal anomaly
scenario = "mhw"
mhw_temp_anomaly = 3.5              # Positive 2m air temperature anomaly (+3.5 °C)
variables = ["u10", "v10", "t2m", "ssrd", "strd"]
drag_formulation = "garratt_1977"   # Dynamic drag coefficient: Cd = (0.75 + 0.067*U10)*1e-3
bulk_heat_flux = true               # Kinematic net heat flux
climatology = false

[boundaries]
parent_ocean = "glorys12v1"         # Base reanalysis hydrography
scenario = "mhw"                    # Warms boundary slope waters (+3.5°C south, +2.5°C east)
obc_type = "flather_chapman"        # Flather radiation for barotropic flow + Chapman for free surface
active_boundaries = ["east", "south", "west"]
sponge_layer_width = 0.25           # Eastern & southern sponge relaxation buffer (degrees lon/lat)
sponge_timescale_seconds = 3600.0   # 1-hour relaxation timescale toward boundary values

[tides]
enable_tides = true                 # Astronomical tidal forcing active
tides_source = "tpxo9_atlas"        # Inverted TPXO9 tidal harmonics
constituents = ["M2", "S2", "N2", "K1", "O1"]
tidal_u_amp = 0.25                  # M2 semi-major tidal velocity amplitude (m/s)
tidal_v_amp = 0.12                  # M2 semi-minor tidal velocity amplitude (m/s)

[bottom_boundary_layer]
cd_drag = 0.0025                    # Realistic quadratic bottom drag coefficient (Cd)
bottom_drag = 0.0001                # Background linear friction rate (s^-1)
bbl_mixing_closure = "tke"          # BBL turbulent kinetic energy closure

[hydrodynamics]
sim_duration_hours = 17520.0        # 2 full years (730 continuous days = 17,520 hours)
sim_dt_seconds = 300.0               # Initial numerical time step (seconds)
adaptive_cfl = true                 # Dynamic CFL adaptive time-stepping controller
target_cfl = 0.25                   # Target advective Courant number
target_wave_cfl = 0.20              # Target wave Courant number
max_dt_seconds = 600.0               # Maximum time step ceiling (seconds)
min_dt_seconds = 2.0                # Minimum allowable time step (seconds)
coriolis_latitude = 44.5            # Reference Coriolis latitude (°N)
divergence_velocity_limit = 20.0    # Stability watchdog threshold (m/s)

[storage]
output_dir = "outputs"
output_filename = "hydrodynamics_mhw_2yr.jld2"
output_schedule_seconds = 21600.0   # Field checkpoint frequency (every 6 hours)
checkpoint_fields = ["u", "v", "w", "T", "S", "η"]
