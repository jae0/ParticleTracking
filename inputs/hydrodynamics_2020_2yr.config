# ==============================================================================
# hydrodynamics_2020_2yr.config - Real Hindcast Configuration (2020-2022, 2 Years)
# Architecture: NumericalEarth.jl + Oceananigans.jl Backend + GPU Acceleration
# Domain: Scotian Shelf, Laurentian Channel & Continental Rise (~2.5 km calibrated)
# ==============================================================================

[metadata]
name = "Scotian Shelf 2-Year Real Ocean Hindcast (2020-2022)"
description = "High-resolution real forcing simulation driven by ERA5, GLORYS12V1, and TPXO9"
author = "Jae Choi"
version = "2.0.0"

[data]
# Real observational & reanalysis data ingestion mode
data_mode = "real"
bathy_dataset_id = "etopo180"            # NOAA ERDDAP bathymetry dataset ID
wind_dataset_id = "erdBSwinds1day"       # NOAA Blended Sea Winds dataset ID
wind_time_iso = "2020-01-01T00:00:00Z"   # Baseline timestamp for wind alignment
inshore_depth = -20.0                    # Coastal boundary depth (meters)
shelf_slope = 500.0                      # Bathymetric continental slope scale (meters)

[climate]
# Real historical hindcast scenario (2 continuous years: 2020 to 2022)
scenario = "historical"
projection_year = 2020
baseline_year = 2020
start_year = 2020
end_year = 2022
horizon_year = 2050

[domain]
lon_min = -68.0                     # Western longitude boundary (°E)
lon_max = -57.0                     # Eastern longitude boundary (°E) - clips tail of Grand Banks
lat_min = 42.0                      # Southern latitude boundary (°N) - deep slope waters
lat_max = 47.5                      # Northern latitude boundary (°N) - Gulf of St. Lawrence entrance
z_min = -5000.0                     # Abyssal plain maximum depth (meters)
z_max = 0.0                         # Sea surface datum (meters)
buffer_km = 50.0                    # Coastal buffer envelope (km)

[grid]
# Discretization resolution: Calibrated ~2.5 km grid for 15.6x acceleration on GPU
nx = 345                            # Zonal grid cell count
ny = 245                            # Meridional grid cell count
nz = 20                             # Number of stretched vertical layers
resolution_scale = 2.5              # Resolution scale factor
vertical_stretching_mode = "tanh"   # Hyperbolic tangent vertical layer stretching
vertical_grid_file = "inputs/scotian_shelf_vertical_grid.csv"

[bathymetry]
source = "numerical_earth"          # Ingest and regrid via NumericalEarth.jl
provider = "gebco"                  # High-resolution GEBCO bathymetry (~450 m raw)
fallback_dataset_id = "etopo180"    # Fallback dataset ID if GEBCO tile absent
inshore_depth = -20.0               # Coastal boundary depth (meters)
shelf_slope = 500.0                 # Bathymetric continental slope scale (meters)

[atmosphere]
# NumericalEarth.DataWrangling ERA5 atmospheric surface forcing
source = "era5"                     # ECMWF ERA5 hourly reanalysis on single levels
time_interval = ["2020-01-01T00:00:00Z", "2021-12-31T23:00:00Z"]
variables = ["u10", "v10", "t2m", "ssrd", "strd"]
drag_formulation = "garratt_1977"   # Dynamic wind speed-dependent drag: Cd = (0.75 + 0.067*U10)*1e-3
bulk_heat_flux = true               # Kinematic net heat flux (SW + LW + Sensible)
climatology = false                 # Full hourly time-resolved observed forcing

[boundaries]
# NumericalEarth.jl 3D ocean boundary conditions
parent_ocean = "glorys12v1"         # Mercator Ocean 1/12° daily global ocean reanalysis
ocean_boundary_source = "glorys12v1"
obc_type = "flather_chapman"        # Flather radiation for barotropic flow + Chapman for free surface
climatology = false                 # Daily observed ocean reanalysis state
active_boundaries = ["east", "south", "west"]
sponge_layer_width = 0.25           # Eastern & southern sponge relaxation buffer (degrees lon/lat)
sponge_timescale_seconds = 3600.0   # 1-hour relaxation timescale toward boundary values

[tides]
# Astronomical tidal body forcing & harmonic synthesis
enable_tides = true                 # Astronomical tidal forcing active
tides_source = "tpxo9_atlas"        # Oregon State TPXO9-Atlas tidal inversion
constituents = ["M2", "S2", "N2", "K1", "O1"] # Primary semi-diurnal and diurnal constituents
tidal_u_amp = 0.25                  # M2 semi-major tidal velocity amplitude (m/s)
tidal_v_amp = 0.12                  # M2 semi-minor tidal velocity amplitude (m/s)
s2_u_amp = 0.11                     # S2 semi-major tidal velocity amplitude (m/s)
s2_v_amp = 0.05                     # S2 semi-minor tidal velocity amplitude (m/s)
tidal_period = 44712.0              # M2 tidal period (seconds, ~12.42 hours)
tidal_phase = 0.0                   # Initial tidal phase angle (radians)

[bottom_boundary_layer]
cd_drag = 0.0025                    # Realistic quadratic bottom drag coefficient (Cd)
bottom_drag = 0.0001                # Background linear friction rate (s^-1)
bbl_mixing_closure = "tke"          # Enhanced benthic boundary layer turbulent mixing

[hydrodynamics]
sim_duration_hours = 17520.0        # 2 full years (730 days = 17,520 hours = 63,072,000 seconds)
sim_dt_seconds = 360.0              # Calibrated time step for ~2.5 km grid (seconds)
adaptive_cfl = true                 # Dynamic CFL adaptive time-stepping controller
target_cfl = 0.20                   # Target advective Courant number
target_wave_cfl = 0.20              # Target barotropic wave Courant number
max_dt_seconds = 600.0              # Maximum time step ceiling (seconds)
min_dt_seconds = 2.0                # Minimum allowable time step before error (seconds)
coriolis_latitude = 44.5            # Reference Coriolis latitude (°N)
divergence_velocity_limit = 20.0    # Stability watchdog threshold (m/s)
surface_heat_flux = 50.0            # Summer net surface heat flux (W/m²)
output_schedule_seconds = 21600.0   # Field serialization cadence (every 6 hours)
hydro_model_file = "hydrodynamics_2020_2yr.jld2"

enable_checkpoint = true                 # Enable periodic prognostic state serialization
checkpoint_schedule = 3600.0             # Checkpoint frequency (seconds; default 1 hour)
checkpoint_dir = ""                      # Checkpoint directory ("" defaults to <output_dir>/checkpoints)
checkpoint_cleanup = true                # Retain only the latest checkpoint file on disk
auto_restart = true                      # Automatically resume incomplete simulations from latest checkpoint
[tessellation]
# NumericalEarth-informed depth-stratified multi-resolution Voronoi areal units
enable_voronoi = true               # Enable multi-resolution Voronoi spatial units
n_units = 5000                      # Total discrete Voronoi spatial units
bathymetry_source = "numerical_earth" # Bathymetry informing tessellation from NumericalEarth.jl
core_depth_min = 50.0               # Core nursery minimum depth (m)
core_depth_max = 350.0              # Core nursery maximum depth (m)
core_prob = 0.8                     # Probability fraction in core nursery zone (80%)
prob_core = 0.8                     # Standardized parameter alias
core_min_res_km = 1.5               # Minimum spatial resolution in core nursery (km)
min_res_core_km = 1.5               # Standardized parameter alias
shallow_depth_min = 0.0             # Shallow coastal minimum depth (m)
shallow_depth_max = 50.0            # Shallow coastal maximum depth (m)
shallow_prob = 0.1                  # Probability fraction in shallow zone (10%)
prob_shallow = 0.1                  # Standardized parameter alias
shallow_min_res_km = 5.0            # Minimum spatial resolution in shallow zone (km)
min_res_shallow_km = 5.0            # Standardized parameter alias
deep_depth_min = 350.0              # Deep slope / abyss depth threshold (m)
deep_depth_max = 6000.0             # Deep slope / abyss maximum depth (m)
deep_prob = 0.1                     # Probability fraction in deep zone (10%)
prob_deep = 0.1                     # Standardized parameter alias
deep_min_res_km = 10.0              # Minimum spatial resolution in deep zone (km)
min_res_deep_km = 10.0              # Standardized parameter alias
slope_weighting = true              # Slope-dependent Poisson spacing refinement
slope_factor = 15.0                 # Refinement factor along steep shelf-breaks and canyons

[biology]
# Lagrangian snow crab particle cohort parameters
n_particles = 500                   # Larval cohort size
track_duration_days = 60.0          # Lagrangian tracking duration (days)
track_dt_seconds = 300.0            # Advection time step (seconds)
min_seabed_depth = 50.0             # Minimum water depth for release (meters)
diffusivity_h = 10.0                # Horizontal eddy diffusivity (m²/s)
diffusivity_v = 1e-4                # Vertical eddy diffusivity (m²/s)
release_depth_mode = "bottom"       # Benthic egg release
bottom_release_offset = [0.5, 3.0]  # Height above seafloor (meters)
enable_initial_ascent = true        # Post-hatch negative geotaxis ascent
ascent_speed = 0.010                # Ascent swimming speed (~10 mm/s)
ascent_target_depth = -10.0         # Ascent target depth (meters)

buffer_km = 50.0                         # Spatial seeding buffer beyond boundaries (km)
[dvm]
# Diel Vertical Migration
enable_dvm = true                   # Stage-dependent DVM swimming
zoea1_day_depth = -50.0
zoea1_night_depth = -10.0
zoea2_day_depth = -55.0
zoea2_night_depth = -8.0
megalopa_day_depth = -120.0
megalopa_night_depth = -60.0

zoea2_depth_factor = 1.0                 # Depth scaling factor
megalopa_swim_factor = 1.0               # Swimming velocity scaling factor
[molting_and_settlement]
enable_molting = true               # Degree-day molting & thermal mortality
t_base = -1.5                       # Base development temperature (°C)
dd_zoea1_to_zoea2 = 65.0            # Zoea I -> Zoea II molt (DD)
dd_zoea2_to_megalopa = 130.0        # Zoea II -> Megalopa molt (DD)
dd_megalopa_to_settle = 200.0       # Megalopa settlement competency (DD)
settlement_min_depth = -350.0       # Nursery maximum depth (meters)
settlement_max_depth = -50.0        # Nursery minimum depth (meters)
settlement_max_temp = 6.0           # Maximum benthic temperature for settlement (°C)

mortality_base = 0.01                    # Baseline natural mortality rate (day^-1)
mortality_thermal_threshold = 15.0       # Thermal stress mortality threshold temperature (°C)
mortality_thermal_sensitivity = 0.02     # Thermal excess mortality sensitivity (°C^-1)
mortality_cold_threshold = 0.0           # Cold stress mortality threshold temperature (°C)
mortality_cold_sensitivity = 0.01        # Cold excess mortality sensitivity (day^-1 °C^-1)

[storage]
output_dir = "outputs"
output_filename = "hydrodynamics_2020_2yr.jld2"
output_schedule_seconds = 21600.0   # Field output frequency (every 6 hours)
checkpoint_fields = ["u", "v", "w", "T", "S", "η"]
enable_duckdb = true                # Persist simulation run to DuckDB
duckdb_path = "outputs/snowcrab_tracking.duckdb" # Analytical DuckDB database path
enable_checkpoint = true            # Enable state checkpointing
checkpoint_prefix = "checkpoint_hydrodynamics_2020_2yr" # Unique model checkpoint filename prefix
checkpoint_schedule = 21600.0       # Checkpoint cadence (every 6 hours)
checkpoint_schedule_seconds = 21600.0
checkpoint_dir = "outputs/checkpoints"
cleanup_checkpoints = true          # Retain only latest checkpoint on disk
auto_restart = true                 # Automatically resume from checkpoint

[hardware]
# Computational execution architecture
use_gpu = true                      # Enable NVIDIA CUDA GPU acceleration
fallback_to_cpu = true              # Fallback to multi-threaded CPU if GPU is absent

[visualization]
interactive_map = true                   # Generate interactive HTML5 + Leaflet.js dashboard
title = "Regional Marine Lagrangian Particle Tracking & Dispersion"

[paths]
output_dir = "outputs"                   # Output directory for data and figures
input_dir = "inputs"                     # Input directory for bathymetry, winds, polygons
seed = 42                                # RNG seed for reproducible stochastic simulations
