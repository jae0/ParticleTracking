# ==============================================================================
# ParticleTracking.config - Centralized Configuration File
# 
# Master parameter specification for regional hydrodynamic circulation,
# tidal harmonics, CMIP6 climate anomalies, and Lagrangian larval transport modeling.
# ==============================================================================

[domain]
# Geographic bounding coordinates (Scotian Shelf, Gulf of St. Lawrence & Slope)
lon_min = -70.0        # Western longitude boundary (degrees East)
lon_max = -54.0        # Eastern longitude boundary (degrees East)
lat_min = 40.0         # Southern latitude boundary (degrees North)
lat_max = 48.5         # Northern latitude boundary (degrees North)
z_min = -500.0        # Maximum seabed bathymetric depth (meters)
z_max = 0.0            # Sea surface height datum (meters)
buffer_km = 50.0      # Spatial buffer extending beyond administrative boundaries (km)

[grid]
# Discretization resolution (Nx, Ny, Nz)
nx = 400                # Number of zonal grid cells
ny = 400                # Number of meridional grid cells
nz = 30                 # Number of vertical depth layers

[data]
# Environmental data ingestion mode: "synthetic" or "real"
data_mode = "real" # "synthetic"
bathy_dataset_id = "etopo180"            # NOAA ERDDAP bathymetry dataset ID
wind_dataset_id = "erdBSwinds1day"       # NOAA Blended Sea Winds dataset ID
wind_time_iso = "2010-06-01T00:00:00Z"   # Reference timestamp for real wind forcing
inshore_depth = -20.0                   # Coastal boundary depth for synthetic shelf (m)
shelf_slope = 500.0                      # Bathymetric slope scale (m)

[tides]
# Astronomical tidal body forcing & harmonic synthesis
enable_tides = true                      # Enable barotropic tidal momentum forcing
constituents = ["M2", "S2"]              # Tidal constituents (:M2, :S2 for spring-neap envelope)
tidal_u_amp = 0.25                       # Semi-major M2 tidal velocity amplitude (m/s)
tidal_v_amp = 0.12                       # Semi-minor M2 tidal velocity amplitude (m/s)
s2_u_amp = 0.11                          # Semi-major S2 tidal velocity amplitude (m/s)
s2_v_amp = 0.05                          # Semi-minor S2 tidal velocity amplitude (m/s)
tidal_period = 44712.0                   # M2 tidal period (seconds, ~12.42 hours)
tidal_phase = 0.0                        # Initial tidal phase angle (radians)

[climate]
# Climate scenarios & projection parameters
scenario = "historical"                  # Scenario: historical, ssp126, ssp245, ssp585, mhw
projection_year = 2020                   # Projection target horizon year
baseline_year = 2020                     # Historical baseline benchmark year
horizon_year = 2050                      # Standard CMIP6 horizon year

[hydrodynamics]
# Oceananigans time integration & numerical stability
sim_duration_hours = 120.0               # Hydrodynamic simulation run duration (hours) = 5 days of spin up
sim_dt_seconds = 120.0                   # Initial time step size (seconds)
adaptive_cfl = true                      # Enable adaptive CFL time stepping
target_cfl = 0.2                         # Target advective Courant-Friedrichs-Lewy limit
divergence_velocity_limit = 20.0         # Maximum velocity threshold for stability watchdog (m/s)
coriolis_latitude = 44.5                 # Reference latitude for Coriolis parameter (degrees N)
surface_heat_flux = 50.0                 # Net surface heat flux in W/m² (positive downward warming)

[biology]
# Lagrangian particle cohort parameters
n_particles = 250                        # Total number of larvae in cohort
track_duration_days = 120.0                # Cohort pelagic drift tracking duration (days)
track_dt_seconds = 300.0                 # Lagrangian advection time step (seconds, 5 mins)
min_seabed_depth = 10.0                 # Minimum water depth for initial placement (meters)
buffer_km = 100.0                        # Spatial seeding buffer beyond stratum boundaries (km)
diffusivity_h = 10.0                     # Horizontal turbulent eddy diffusivity (m^2/s)
diffusivity_v = 1e-4                     # Vertical turbulent eddy diffusivity (m^2/s)
release_depth_mode = "bottom"            # Vertical release mode: "bottom" (seabed), "range", or "surface"
bottom_release_offset = [0.5, 3.0]       # Elevation above seabed for bottom release (meters)
enable_initial_ascent = true             # Enable post-hatch negative geotactic vertical ascent
ascent_speed = 0.010                     # Directed upward swimming speed during ascent (m/s, ~10 mm/s)
ascent_target_depth = -10.0              # Target epipelagic depth for ascent completion (meters)

[dvm]
# Stage-specific Diel Vertical Migration (DVM) swimming behavior
enable_dvm = true                        # Enable DVM vertical swimming behaviors
megalopa_day_depth = -120.0              # Megalopa daytime target depth (meters)
megalopa_night_depth = -60.0             # Megalopa nighttime target depth (meters)
zoea2_depth_factor = 1.2                 # Zoea II depth scaling relative to Zoea I
megalopa_swim_factor = 1.5               # Megalopa swimming velocity factor relative to Zoea I

[molting_and_settlement]
# Thermal physiology, cumulative degree-days & benthic settlement
enable_molting = true                     # Enable temperature-dependent molting and mortality
t_base = -1.5                             # Physiological development base temperature (°C)
dd_zoea1_to_zoea2 = 65.0                  # Cumulative degree-days for Zoea I -> Zoea II molt
dd_zoea2_to_megalopa = 130.0              # Cumulative degree-days for Zoea II -> Megalopa molt
dd_megalopa_to_settle = 200.0             # Cumulative degree-days for Megalopa settlement competency
mortality_base = 0.02                     # Baseline natural mortality rate (day^-1)
mortality_thermal_threshold = 7.0         # Thermal stress mortality threshold temperature (°C)
mortality_thermal_sensitivity = 0.35      # Thermal excess mortality sensitivity (°C^-1)
mortality_cold_threshold = -1.5           # Cold stress mortality threshold temperature (°C)
mortality_cold_sensitivity = 0.02         # Cold excess mortality sensitivity (day^-1 °C^-1)
settlement_min_depth = -250.0            # Nursery settlement maximum depth limit (meters)
settlement_max_depth = -50.0             # Nursery settlement minimum depth limit (meters)
settlement_max_temp = 6.0                # Maximum benthic temperature for settlement (°C)

[storage]
# DuckDB analytical database & parquet export
enable_duckdb = true                     # Persist all scenario runs to DuckDB
duckdb_path = "outputs/particle_tracking.duckdb" # Path to DuckDB analytical database
export_parquet = false                   # Export DuckDB tables to Apache Parquet format

[hardware]
# Computational execution architecture
use_gpu = false                          # Enable NVIDIA CUDA GPU acceleration
fallback_to_cpu = true                   # Fallback to multi-threaded CPU if GPU is absent

[visualization]
# Plotting and interactive dashboard options
interactive_map = true                   # Generate interactive HTML5 + Leaflet.js dashboard
title = "Scotian Shelf Snow Crab Larval Dispersal & Demographic Connectivity"

[paths]
# Directory paths & random number generator seed
output_dir = "outputs"                   # Output directory for data and figures
input_dir = "inputs"                     # Input directory for bathymetry, winds, polygons
seed = 42                                # RNG seed for reproducible stochastic simulations
