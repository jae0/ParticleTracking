# ==============================================================================
# ParticleTracking.config - Centralized Master Configuration File
# 
# Master parameter specification for regional hydrodynamic circulation,
# tidal harmonics, environmental forcing, and Lagrangian snow crab
# (Chionoecetes opilio) larval transport modeling.
# 
# Incorporating ClimaOcean.jl turbulence closures, ETOPO 2022 (15 arc-sec; ~500 m),
# ERA5 high-resolution atmospheric reanalysis, WOA23 hydrography & dissolved oxygen,
# and lateral boundary relaxation (Price & Aumont 2011).
# ==============================================================================

[metadata]
name = "Scotian Shelf & Northwest Atlantic Regional Hydrodynamics & Particle Tracking"
description = "Coupled regional simulation driven by ETOPO 2022, ERA5, WOA23, and ClimaOcean closures"
author = "Jae Choi"
version = "2.0.0"

[domain]
# Geographic bounding coordinates (Scotian Shelf and Northwest Atlantic)
lon_min = -70.0        # Western longitude boundary (degrees East)
lon_max = -54.0        # Eastern longitude boundary (degrees East)
lat_min = 40.0         # Southern latitude boundary (degrees North)
lat_max = 48.5         # Northern latitude boundary (degrees North)
z_min = -1500.0        # Maximum seabed bathymetric depth (meters)
z_max = 0.0            # Sea surface height datum (meters)
buffer_km = 50.0       # Spatial buffer extending beyond boundaries (km)

[grid]
# Discretization resolution (Nx, Ny, Nz)
nx = 100               # Number of zonal grid cells
ny = 100               # Number of meridional grid cells
nz = 20                # Number of vertical depth layers
resolution_scale = 1.0 # Spatial resolution scale factor
vertical_stretching_mode = "tanh" # Vertical coordinate stretching mode
vertical_grid_file = "inputs/scotian_shelf_vertical_grid.csv"

[data]
# Environmental data ingestion mode: "synthetic" or "real"
data_mode = "real"
bathy_dataset_id = "nceiEtopo2022"       # NOAA ETOPO 2022 15 arc-sec relief dataset ID
wind_dataset_id = "erdBSwinds1day"       # NOAA Blended Sea Winds dataset ID
hydrography_source = "woa23"             # World Ocean Atlas 2023 climatology
wind_time_iso = "2020-06-01T00:00:00Z"   # Reference timestamp for real wind forcing
inshore_depth = -20.0                    # Coastal boundary depth for synthetic shelf (m)
shelf_slope = 500.0                      # Bathymetric slope scale (m)

[bathymetry]
# NumericalEarth seabed bathymetry ingestion
source = "numerical_earth"               # Bathymetry provider engine
provider = "etopo2022"                   # High-resolution ETOPO 2022 relief model
resolution_arcsec = 15                   # 15 arc-second (~500 m) horizontal cell spacing
fallback_dataset_id = "etopo180"         # Global fallback dataset ID

[boundaries]
# Lateral ocean open boundary conditions & relaxation
method = "relaxation"                    # Lateral boundary relaxation (Price & Aumont 2011)
ocean_boundary_source = "glorys12v1"     # CMEMS ocean physics reanalysis
obc_type = "flather_chapman"             # Radiation and sponge boundary formulation
active_boundaries = ["east", "south", "west"]
sponge_layer_width = 0.35                # Peripheral sponge relaxation width (degrees lon/lat)
sponge_timescale = 3600.0                # Relaxation timescale toward boundary values (seconds)
u_inflow = -0.15                         # Upstream along-shelf Nova Scotia Current driver (m/s)
v_inflow = 0.05                          # Offshore cross-shelf reference velocity (m/s)

[atmosphere]
# Atmospheric surface wind stress and heat fluxes
source = "era5"                          # Atmospheric reanalysis provider (ECMWF ERA5)
drag_formulation = "garratt_1977"        # Dynamic wind speed-dependent drag: Cd = (0.75 + 0.067*U10)*1e-3
bulk_heat_flux = true                    # Kinematic net heat flux (SW + LW + Sensible)
climatology = false                      # Time-resolved observed forcing

[tides]
# Astronomical tidal body forcing & harmonic synthesis
enable_tides = true                      # Enable barotropic tidal momentum forcing
constituents = ["M2", "S2"]              # Tidal constituents for spring-neap envelope
tidal_u_amp = 0.20                       # Semi-major M2 tidal velocity amplitude (m/s)
tidal_v_amp = 0.10                       # Semi-minor M2 tidal velocity amplitude (m/s)
s2_u_amp = 0.08                          # Semi-major S2 tidal velocity amplitude (m/s)
s2_v_amp = 0.04                          # Semi-minor S2 tidal velocity amplitude (m/s)
tidal_period = 44712.0                   # M2 tidal period (seconds, ~12.42 hours)
tidal_phase = 0.0                        # Initial tidal phase angle (radians)

[climate]
# Climate scenarios & projection parameters
scenario = "historical"                  # Scenario: historical, ssp126, ssp245, ssp585, mhw
projection_year = 2020                   # Projection target horizon year
baseline_year = 2020                     # Historical baseline benchmark year
horizon_year = 2050                      # Standard CMIP6 horizon year

[hydrodynamics]
# Oceananigans time integration & turbulence closures
sim_duration_hours = 120.0               # Hydrodynamic simulation run duration (hours)
sim_dt_seconds = 120.0                   # Initial time step size (seconds)
adaptive_cfl = true                      # Enable adaptive CFL time stepping
target_cfl = 0.2                         # Target advective Courant-Friedrichs-Lewy limit
divergence_velocity_limit = 20.0         # Maximum velocity threshold for stability watchdog (m/s)
coriolis_latitude = 44.5                 # Reference latitude for Coriolis parameter (degrees N)
surface_heat_flux = 50.0                 # Net surface heat flux in W/m² (positive downward warming)
turbulence_closure = "nemotke"           # ClimaOcean NEMO-TKE vertical turbulence closure (:nemotke, :kpp)
enable_sea_ice = true                    # ClimaOcean frazil / thermodynamic seawater freezing point
enable_oxygen = true                     # Dissolved oxygen (O2) prognostic tracer
enable_checkpoint = true                 # Enable periodic prognostic state serialization
checkpoint_schedule = 3600.0             # Checkpoint frequency (seconds; default 1 hour)
checkpoint_dir = ""                      # Checkpoint directory ("" defaults to <output_dir>/checkpoints)
checkpoint_cleanup = true                # Retain only the latest checkpoint file on disk
auto_restart = true                      # Automatically resume incomplete simulations from latest checkpoint

[biology]
# Lagrangian particle cohort parameters (snow crab larval dispersal)
n_particles = 100                        # Total number of particles in cohort
track_duration_days = 60.0               # Pelagic drift tracking duration (days)
track_dt_seconds = 300.0                 # Lagrangian advection time step (seconds, 5 mins)
min_seabed_depth = 50.0                  # Minimum water depth for initial placement (meters)
buffer_km = 50.0                         # Spatial seeding buffer beyond boundaries (km)
diffusivity_h = 10.0                     # Horizontal turbulent eddy diffusivity (m^2/s)
diffusivity_v = 1e-4                     # Vertical turbulent eddy diffusivity (m^2/s)
release_depth_mode = "bottom"            # Vertical release mode: "bottom", "range", or "surface"
bottom_release_offset = [0.5, 3.0]       # Elevation above seabed if bottom release selected (meters)
enable_initial_ascent = true             # Enable post-hatch negative geotaxis vertical ascent
ascent_speed = 0.010                     # Swimming ascent velocity (m/s)
ascent_target_depth = -10.0              # Target epipelagic depth for ascent completion (meters)

[dvm]
# Diel Vertical Migration (DVM) swimming behavior
enable_dvm = true                        # Stage-dependent active DVM swimming
zoea1_day_depth = -50.0
zoea1_night_depth = -10.0
zoea2_day_depth = -55.0
zoea2_night_depth = -8.0
megalopa_day_depth = -120.0
megalopa_night_depth = -60.0
zoea2_depth_factor = 1.0                 # Depth scaling factor
megalopa_swim_factor = 1.0               # Swimming velocity scaling factor

[molting_and_settlement]
# Degree-day thermal molting and benthic settlement
enable_molting = true                    # Degree-day molting & thermal mortality active
t_base = -1.5                            # Base development temperature (°C)
dd_zoea1_to_zoea2 = 65.0                 # Zoea I -> Zoea II molt (degree-days)
dd_zoea2_to_megalopa = 130.0             # Zoea II -> Megalopa molt (degree-days)
dd_megalopa_to_settle = 200.0            # Megalopa settlement competency (degree-days)
mortality_base = 0.01                    # Baseline natural mortality rate (day^-1)
mortality_thermal_threshold = 15.0        # Thermal stress threshold temperature (°C)
mortality_thermal_sensitivity = 0.02      # Thermal excess mortality sensitivity (°C^-1)
mortality_cold_threshold = -1.5          # Cold stress threshold temperature (°C)
mortality_cold_sensitivity = 0.01         # Cold excess mortality sensitivity (day^-1 °C^-1)
settlement_min_depth = -350.0            # Nursery maximum depth (meters)
settlement_max_depth = -50.0             # Nursery minimum depth (meters)
settlement_max_temp = 6.0                # Maximum benthic temperature for settlement (°C)

[storage]
output_dir = "outputs"
output_filename = "particle_tracking.jld2"
output_schedule_seconds = 21600.0        # Field serialization cadence (every 6 hours)
enable_duckdb = true                     # Persist simulation run to DuckDB
duckdb_path = "outputs/particle_tracking.duckdb"
enable_checkpoint = true
checkpoint_prefix = "checkpoint_ParticleTracking"
checkpoint_schedule_seconds = 21600.0
checkpoint_dir = "outputs/checkpoints"
cleanup_checkpoints = true
auto_restart = true

[hardware]
# Computational execution architecture
use_gpu = true                           # Enable NVIDIA CUDA GPU acceleration
fallback_to_cpu = true                   # Fallback to multi-threaded CPU if GPU is absent

[visualization]
interactive_map = true                   # Generate interactive HTML5 Leaflet map
animate_hydro = false                    # Animate hydrodynamic fields
anim_variable = "dashboard"              # Default animation variable
anim_fps = 10                            # Frames per second
anim_format = "mp4"                      # Video output format
anim_depth = -50.0                       # Depth slice for field animation (meters)
anim_overlay_particles = false           # Overlay Lagrangian particles
anim_output_path = ""
title = "Scotian Shelf Snow Crab Larval Dispersal & Regional Hydrodynamics"

[paths]
output_dir = "outputs"                   # Output directory for data and figures
input_dir = "inputs"                     # Input directory for bathymetry, winds, polygons
seed = 42                                # RNG seed for reproducible stochastic simulations
