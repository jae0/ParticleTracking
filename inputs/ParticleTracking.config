# ==============================================================================
# ParticleTracking.config - Centralized Configuration File
# 
# Master parameter specification for regional hydrodynamic circulation,
# tidal harmonics, environmental forcing, and generic Lagrangian particle tracking.
# ==============================================================================

[domain]
# Geographic bounding coordinates (Scotian Shelf and Northwest Atlantic)
lon_min = -70.0        # Western longitude boundary (degrees East)
lon_max = -54.0        # Eastern longitude boundary (degrees East)
lat_min = 40.0         # Southern latitude boundary (degrees North)
lat_max = 48.5         # Northern latitude boundary (degrees North)
z_min = -1500.0        # Maximum seabed bathymetric depth (meters)
z_max = 0.0            # Sea surface height datum (meters)
buffer_km = 50.0       # Spatial buffer extending beyond boundaries (km)

[grid]
# Discretization resolution (Nx, Ny, Nz)
nx = 100               # Number of zonal grid cells
ny = 100               # Number of meridional grid cells
nz = 20                # Number of vertical depth layers
resolution_scale = 1.0 # Spatial resolution scale factor
vertical_stretching_mode = "tanh" # Vertical coordinate stretching mode
vertical_grid_file = "inputs/scotian_shelf_vertical_grid.csv"

[data]
# Environmental data ingestion mode: "synthetic" or "real"
data_mode = "real"
bathy_dataset_id = "etopo180"            # NOAA ERDDAP bathymetry dataset ID
wind_dataset_id = "erdBSwinds1day"       # NOAA Blended Sea Winds dataset ID
wind_time_iso = "2020-06-01T00:00:00Z"   # Reference timestamp for real wind forcing
inshore_depth = -20.0                    # Coastal boundary depth for synthetic shelf (m)
shelf_slope = 500.0                      # Bathymetric slope scale (m)

[bathymetry]
# NumericalEarth seabed bathymetry ingestion
source = "numerical_earth"               # Bathymetry provider engine
provider = "gebco"                       # Primary regional bathymetric dataset

[boundaries]
# Lateral ocean open boundary conditions
ocean_boundary_source = "glorys12v1"     # CMEMS ocean physics reanalysis
obc_type = "flather_chapman"             # Radiation and sponge boundary formulation

[atmosphere]
# Atmospheric surface wind stress and heat fluxes
source = "era5"                          # Atmospheric reanalysis provider

[tides]
# Astronomical tidal body forcing & harmonic synthesis
enable_tides = true                      # Enable barotropic tidal momentum forcing
constituents = ["M2", "S2"]              # Tidal constituents for spring-neap envelope
tidal_u_amp = 0.20                       # Semi-major M2 tidal velocity amplitude (m/s)
tidal_v_amp = 0.10                       # Semi-minor M2 tidal velocity amplitude (m/s)
s2_u_amp = 0.08                          # Semi-major S2 tidal velocity amplitude (m/s)
s2_v_amp = 0.04                          # Semi-minor S2 tidal velocity amplitude (m/s)
tidal_period = 44712.0                   # M2 tidal period (seconds, ~12.42 hours)
tidal_phase = 0.0                        # Initial tidal phase angle (radians)

[climate]
# Climate scenarios & projection parameters
scenario = "historical"                  # Scenario: historical, ssp126, ssp245, ssp585, mhw
projection_year = 2020                   # Projection target horizon year
baseline_year = 2020                     # Historical baseline benchmark year
horizon_year = 2050                      # Standard CMIP6 horizon year

[hydrodynamics]
# Oceananigans time integration & numerical stability
sim_duration_hours = 24.0                # Hydrodynamic simulation run duration (hours)
sim_dt_seconds = 180.0                   # Initial time step size (seconds)
adaptive_cfl = true                      # Enable adaptive CFL time stepping
target_cfl = 0.2                         # Target advective Courant-Friedrichs-Lewy limit
divergence_velocity_limit = 20.0         # Maximum velocity threshold for stability watchdog (m/s)
coriolis_latitude = 44.5                 # Reference latitude for Coriolis parameter (degrees N)
surface_heat_flux = 50.0                 # Net surface heat flux in W/m² (positive downward warming)
enable_checkpoint = true                 # Enable periodic prognostic state serialization
checkpoint_schedule = 3600.0             # Checkpoint frequency (seconds; default 1 hour)
checkpoint_dir = ""                      # Checkpoint directory ("" defaults to <output_dir>/checkpoints)
checkpoint_cleanup = true                # Retain only the latest checkpoint file on disk
auto_restart = true                      # Automatically resume incomplete simulations from latest checkpoint

[biology]
# Lagrangian particle cohort parameters (generic drifters / passive tracers)
n_particles = 100                        # Total number of particles in cohort
track_duration_days = 14.0               # Pelagic drift tracking duration (days)
track_dt_seconds = 300.0                 # Lagrangian advection time step (seconds, 5 mins)
min_seabed_depth = 10.0                  # Minimum water depth for initial placement (meters)
buffer_km = 50.0                         # Spatial seeding buffer beyond boundaries (km)
diffusivity_h = 10.0                     # Horizontal turbulent eddy diffusivity (m^2/s)
diffusivity_v = 1e-4                     # Vertical turbulent eddy diffusivity (m^2/s)
release_depth_mode = "surface"           # Vertical release mode: "surface", "range", or "bottom"
bottom_release_offset = [0.5, 3.0]       # Elevation above seabed if bottom release selected (meters)
enable_initial_ascent = false            # Disable directed vertical ascent for surface/generic particles
ascent_speed = 0.005                     # Swimming / ascent velocity if enabled (m/s)
ascent_target_depth = -5.0               # Target depth for surface particles (meters)

[dvm]
# Diel Vertical Migration (DVM) swimming behavior
enable_dvm = false                       # Disable active DVM for generic passive/neutral particles
megalopa_day_depth = -50.0               # Daytime target depth if DVM activated (meters)
megalopa_night_depth = -10.0             # Nighttime target depth if DVM activated (meters)
zoea2_depth_factor = 1.0                 # Depth scaling factor
megalopa_swim_factor = 1.0               # Swimming velocity scaling factor

[molting_and_settlement]
# Development stages, thermal physiology & settlement
enable_molting = false                   # Disable stage molting for generic particles
t_base = 0.0                             # Development base temperature (°C)
dd_zoea1_to_zoea2 = 100.0                # Degree-days threshold for stage 1 -> stage 2
dd_zoea2_to_megalopa = 200.0             # Degree-days threshold for stage 2 -> stage 3
dd_megalopa_to_settle = 300.0            # Degree-days threshold for settlement competency
mortality_base = 0.01                    # Baseline natural mortality rate (day^-1)
mortality_thermal_threshold = 15.0       # Thermal stress mortality threshold temperature (°C)
mortality_thermal_sensitivity = 0.02     # Thermal excess mortality sensitivity (°C^-1)
mortality_cold_threshold = 0.0           # Cold stress mortality threshold temperature (°C)
mortality_cold_sensitivity = 0.01        # Cold excess mortality sensitivity (day^-1 °C^-1)
settlement_min_depth = -500.0            # Habitat settlement maximum depth limit (meters)
settlement_max_depth = -10.0             # Habitat settlement minimum depth limit (meters)
settlement_max_temp = 12.0               # Maximum bottom temperature for settlement (°C)

[tessellation]
# Multi-resolution spatial Voronoi tessellation
enable_voronoi = false                   # Enable depth-stratified Voronoi spatial units
n_units = 1000                           # Target number of spatial units
prob_core = 0.5                          # Sampling weight for intermediate depth stratum
prob_shallow = 0.25                      # Sampling weight for shallow coastal stratum
prob_deep = 0.25                         # Sampling weight for deep bathymetric stratum
min_res_core_km = 3.0                    # Minimum Poisson-disc separation in core stratum (km)
min_res_shallow_km = 5.0                 # Minimum separation in shallow stratum (km)
min_res_deep_km = 10.0                   # Minimum separation in deep stratum (km)
bathymetry_source = "numerical_earth"    # Seabed depth provider
slope_weighting = true                   # Bathymetric gradient / slope weighting

[storage]
# DuckDB analytical database & parquet export
enable_duckdb = true                     # Persist simulation runs to DuckDB
duckdb_path = "outputs/particle_tracking.duckdb" # Path to DuckDB analytical database
export_parquet = false                   # Export DuckDB tables to Apache Parquet format
enable_checkpoint = true                 # Enable prognostic state checkpointing
checkpoint_prefix = "checkpoint_ParticleTracking" # Unique model checkpoint filename prefix
checkpoint_schedule_seconds = 21600.0    # Checkpoint cadence (every 6 hours)
checkpoint_dir = "outputs/checkpoints"   # State checkpoint directory
cleanup_checkpoints = true               # Retain latest checkpoint on disk

[hardware]
# Computational execution architecture
use_gpu = false                          # GPU acceleration (false for generic portable baseline)
fallback_to_cpu = true                   # Fallback to multi-threaded CPU if GPU is absent

[visualization]
# Plotting and interactive dashboard options
interactive_map = true                   # Generate interactive HTML5 + Leaflet.js dashboard
title = "Regional Marine Lagrangian Particle Tracking & Dispersion"

[paths]
# Directory paths & random number generator seed
output_dir = "outputs"                   # Output directory for data and figures
input_dir = "inputs"                     # Input directory for bathymetry, winds, polygons
seed = 42                                # RNG seed for reproducible stochastic simulations
